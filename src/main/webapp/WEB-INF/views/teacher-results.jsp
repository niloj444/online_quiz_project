<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %><%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><c:set var="pageTitle" value="Assessment Results"/><%@ include file="_header.jspf" %>
<h1>Assessment Results</h1><section class="card"><form method="get" action="${pageContext.request.contextPath}/teacher/results"><label>Select your quiz</label><select name="quizId" onchange="this.form.submit()"><option value="">Choose an assessment</option><c:forEach var="q" items="${quizzes}"><option value="${q.id}" ${q.id == selectedQuizId ? 'selected' : ''}><c:out value="${q.title}"/></option></c:forEach></select></form></section>
<c:if test="${selectedQuizId > 0}"><div class="stats-grid"><div class="stat-card"><div class="stat-num">${totalAttempts}</div><div class="stat-label">Attempts</div></div><div class="stat-card"><div class="stat-num">${averageScore}%</div><div class="stat-label">Average score</div></div><div class="stat-card"><div class="stat-num">${highestScore}%</div><div class="stat-label">Highest score</div></div><div class="stat-card"><div class="stat-num">${passRate}%</div><div class="stat-label">Pass percentage</div></div></div><table><thead><tr><th>Student</th><th>Quiz</th><th>Score</th><th>Percentage</th><th>Pass/Fail</th><th>Submission date</th></tr></thead><tbody><c:forEach var="r" items="${results}"><tr><td><c:out value="${r.studentName}"/></td><td><c:out value="${r.quizName}"/></td><td>${r.score}/${r.total}</td><td>${r.percent}%</td><td><span class="status-tag ${r.passed ? 'tag-pass' : 'tag-fail'}">${r.passed ? 'Pass' : 'Fail'}</span></td><td>${r.takenAt}</td></tr></c:forEach></tbody></table><c:if test="${empty results}"><p class="muted">No attempts for this assessment yet.</p></c:if></c:if>
<%@ include file="_footer.jspf" %>
