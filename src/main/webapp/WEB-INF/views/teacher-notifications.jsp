<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %><%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><c:set var="pageTitle" value="Notifications"/><%@ include file="_header.jspf" %>
<h1>Notify Students</h1><c:if test="${param.sent == '1'}"><p class="notice ok">Notification published for students.</p></c:if><section class="card"><form method="post" action="${pageContext.request.contextPath}/teacher/notifications"><label>Quiz</label><select name="quizId" required><option value="">Choose your quiz</option><c:forEach var="q" items="${quizzes}"><option value="${q.id}"><c:out value="${q.subject}"/> — <c:out value="${q.title}"/></option></c:forEach></select><label>Notification title</label><input name="title" required><label>Message</label><textarea name="message" rows="4" required></textarea><button class="btn" type="submit">Publish notification</button></form></section><%@ include file="_footer.jspf" %>
