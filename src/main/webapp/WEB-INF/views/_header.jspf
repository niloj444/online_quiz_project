<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}"/> - Online Quiz</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="${pageContext.request.contextPath}/quiz">Online Quiz</a>
  <c:if test="${not empty sessionScope.user}">
    <nav>
      <a href="${pageContext.request.contextPath}/quiz">Take quiz</a>
      <c:if test="${not sessionScope.user.teacher and not sessionScope.user.admin}"><a href="${pageContext.request.contextPath}/student/dashboard">Student dashboard</a></c:if>
      <a href="${pageContext.request.contextPath}/result">My results</a>
      <c:if test="${sessionScope.user.teacher or sessionScope.user.admin}">
        <a href="${pageContext.request.contextPath}/teacher/dashboard">Teacher dashboard</a>
        <a href="${pageContext.request.contextPath}/teacher/results">Assessment results</a>
        <a href="${pageContext.request.contextPath}/teacher/notifications">Notifications</a>
        <a href="${pageContext.request.contextPath}/admin/questions">Question bank</a>
      </c:if>
      <c:if test="${sessionScope.user.admin}">
        <a href="${pageContext.request.contextPath}/admin/questions">Manage questions</a>
        <a href="${pageContext.request.contextPath}/admin/results">Student results</a>
      </c:if>
      <form method="post" action="${pageContext.request.contextPath}/logout">
        <button type="submit" class="link-button">Log out (<c:out value="${sessionScope.user.name}"/>)</button>
      </form>
    </nav>
  </c:if>
</header>
<main class="page">
