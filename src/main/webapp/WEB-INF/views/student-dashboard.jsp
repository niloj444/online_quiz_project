<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %><%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><c:set var="pageTitle" value="Student Dashboard"/><%@ include file="_header.jspf" %>
<h1>Student Dashboard</h1><p>Welcome, <strong><c:out value="${sessionScope.user.name}"/></strong></p><div class="stats-grid"><div class="stat-card"><div class="stat-num">${available}</div><div class="stat-label">Available</div></div><div class="stat-card"><div class="stat-num">${completed}</div><div class="stat-label">Completed</div></div><div class="stat-card"><div class="stat-num">${average}%</div><div class="stat-label">Average</div></div><div class="stat-card"><div class="stat-num">${passed}/${failed}</div><div class="stat-label">Pass / Fail</div></div></div>
<c:if test="${not empty notifications}"><h2>🔔 Notifications (${notifications.size()})</h2><c:forEach var="n" items="${notifications}"><section class="card notification"><strong><c:out value="${n.title}"/></strong><p><c:out value="${n.message}"/></p><a href="${pageContext.request.contextPath}/assessment/start?id=${n.quizId}">Open quiz</a></section></c:forEach></c:if>
<h2>Available Quizzes</h2><form method="get"><label>Filter by subject</label><select name="subject" onchange="this.form.submit()"><option value="">All Subjects</option><c:forEach var="s" items="${subjects}"><option value="${s}" ${s == selectedSubject ? 'selected' : ''}><c:out value="${s}"/></option></c:forEach></select></form><div class="quiz-list"><c:forEach var="q" items="${quizzes}"><section class="card quiz-summary"><p class="muted"><c:out value="${q.subject}"/></p><h2><c:out value="${q.title}"/></h2><p><span class="status-tag tag-type">${q.quizType}</span> &nbsp; ${q.questionCount} questions &nbsp; ${q.durationMinutes} min &nbsp; Pass: ${q.passingPercentage}%</p><c:if test="${not empty q.dueDate}"><p class="muted">Due: ${q.dueDate}</p></c:if><c:choose><c:when test="${q.completed}"><span class="status-tag tag-pass">COMPLETED — ${q.lastScore}%</span></c:when><c:when test="${q.overdue}"><span class="status-tag tag-fail">OVERDUE</span></c:when><c:otherwise><a class="btn" href="${pageContext.request.contextPath}/assessment/start?id=${q.id}">Start Quiz</a></c:otherwise></c:choose></section></c:forEach></div>
<h2>My Subject Performance</h2><table><thead><tr><th>Subject</th><th>Attempts</th><th>Average</th><th>Highest</th><th>Pass</th><th>Fail</th></tr></thead><tbody><c:forEach var="p" items="${performance}"><tr><td><c:out value="${p.subject}"/></td><td>${p.attempts}</td><td>${p.averageDisplay}</td><td>${p.highest}%</td><td>${p.passed}</td><td>${p.failed}</td></tr></c:forEach></tbody></table><p><a class="btn ghost" href="${pageContext.request.contextPath}/result">My full record</a></p><%@ include file="_footer.jspf" %>
